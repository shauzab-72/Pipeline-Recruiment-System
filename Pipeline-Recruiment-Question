using namespace std;
template <class T>
class ArrayList {
private:
	void regrow() {
		if (maxCount == 0) {
			maxCount = 4;
		}
		else maxCount = maxCount * 2;
		T* temp = new T[maxCount];
		for (int i = 0; i < count; i++) {
			temp[i] = arr[i];
		}
		delete[] arr;
		arr = temp;
	}
	void shrink() {
		if(maxCount<=4){
			return;
		}
		maxCount = maxCount / 2;
		T* temp = new T[maxCount];
			for (int i = 0; i < count; i++) {
				temp[i] = arr[i];
		}
		delete[]arr;
		arr = temp;
	}
public:
	T* arr;
	int maxCount;
	int count;
	ArrayList(int count=4) {
		this->maxCount = count;
		arr = new T[maxCount];
		this->count = 0;
	}
	ArrayList(const ArrayList& Obj) {
		if (this == &Obj) {
			throw runtime_error("pointing at the same Object!");
		}
		this->maxCount = Obj.maxCount;
		arr = new T[this->maxCount];
		this->count = Obj.count;
		for (int i = 0; i < this->count; i++) {
			arr[i] = Obj.arr[i];
		}
	}
	void operator=(const ArrayList& obj) {
		if (this == &obj) {
			throw runtime_error("pointing at the same Object!");
		}
		this->maxCount = obj.maxCount;
		this->count = obj.count;
		if (this->arr != nullptr)delete[]arr;
		this->arr = new T[this->maxCount];
		for (int i = 0; i < this->count; i++) {
			this->arr[i] = obj.arr[i];
		}
	}
	void shiftRight(int pos) {
		if (pos<0 || pos>=count) {
			throw runtime_error("Invalid entry");
		}
		for (int i = count; i > pos; i--) {
			arr[i] = arr[i - 1];
		}
	}
	void shiftLeft(int pos) {
		if (pos<0 || pos>=count) {
			throw runtime_error("Invalid entry");
		}
		for (int i = pos; i < count-1; i++) {
			arr[i] = arr[i + 1];
		}
	}
	bool isFull() {
		return count == maxCount;
	}
	bool isEmpty() {
		return count == 0;
	}
	void insertAtStart(T data) {
		if (isFull()) { regrow(); }
		if (count > 0) { shiftRight(0); }
		arr[0] = data;
		count++;
	}
	void insertAtEnd(T data) {
		if (isFull()) { regrow(); }
		arr[count] = data;
		count++;
	}
	void insertAt(int pos, T data) {
		if (pos < 0 || pos >= count) { 
			throw runtime_error("Invalid entry"); 
		}
		else {
			if (isFull()) { regrow(); }
			if (count > 0) { shiftRight(pos); }
			arr[pos] = data;
			count++;
		}
	}
	void insertAfter(T data, int pos) {
		if (pos < 0 || pos >= count) {
			throw runtime_error("Invalid entry");
		}
		insertAt(pos+1, data);
	}
	void insertBefore(T data, int pos) {
		if (pos < 0 || pos >= count) {
			throw runtime_error("Invalid entry");
		}
		insertAt(pos - 1, data);
	}
	void removeFromEnd() {
		if (isEmpty()) { 
			throw runtime_error("Empty list"); 
		}
		count--;
		if (count <= maxCount / 4) { shrink();}
	}
	void removeFromStart() {
		if (isEmpty()) {
			throw runtime_error("Empty list");
		}
		if (count > 0) {
			shiftLeft(0);
		}
		count--;
		if (count <= maxCount / 4) { shrink(); }
	}
	void removeAt(int pos) {
		if (isEmpty()) {
			throw runtime_error("Empty list");
		}
		if (count > 0) { shiftLeft(pos); }
		count--;
		if (count <= maxCount / 4) { shrink(); }
	}
	void removeBefore(int pos) {
		if (pos < 0 || pos >= count) {
			throw runtime_error("Invalid entry");
		}
		removeAt(pos-1);
	}
	void removeAfter(int pos) {
		if (pos < 0 || pos >= count) {
			throw runtime_error("Invalid entry");
		}
		removeAt(pos+1);
	}
	void display()const {
		for (int i = 0; i < count; i++) {
			cout << arr[i] << " ";
		}
		cout << endl;
	}
	T& At(int& index) {
		if (index < 0 || index >= count) {
			throw runtime_error("Invalid entry");
		}
		return arr[index];
	}
	int getCount() const {
		return count;
	}
	~ArrayList() {
		delete[] arr;
	}
	friend ostream& operator<<(ostream& os, const ArrayList<T>& obj) {
		for (int i = 0; i < obj.count; i++) {
			os << obj.arr[i] << " ";
		}
		os << endl;
		return os;
	}
};
