class Stage {
public:
	string stageName;
	ArrayList<Candidate> candidates;
	Stage* next;
	Stage() {
		stageName = "N/A";
		next = nullptr;
	}
	Stage(string name, int maxCandidates=4):candidates(maxCandidates) {
		this->stageName = name;
	}
	~Stage(){}
};
class RecruitmentPipeLine {
	Stage* head;
public:
	RecruitmentPipeLine():head(nullptr) {
		if (head == nullptr) {
			head = new Stage("Applied");
			head->next = new Stage("Screening");
			head->next->next = new Stage("Technical Interview");
			head->next->next->next = new Stage("HR Interview");
			head->next->next->next->next = new Stage("Selected");
		}
	}
	Stage* getHead()const {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		return head;
	}
	int lengthOfPipeline() {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		int size = 1;
		Stage* temp = head;
		while (temp->next != nullptr) {
			size++;
			temp = temp->next;
		}
		return size;
	}
	~RecruitmentPipeLine() {
		if (head != nullptr) {
			if (head->next == nullptr) {
				delete head;
			}
			else {
				Stage* prev = head;
				Stage* curr = head->next;
				while (curr != nullptr) {
					delete prev;
					prev = curr;
					curr = curr->next;
				}
				delete prev;
				cout << "Pipeline succesfully deleted" << endl;
			}
		}
		else {
			cout << "head already on NULL" << endl;
		}
	}
	//Time complexity: O(n) -> single loop used
	//Space complexity: O(1) -> only new stage on heap allocated 
	void insertStage(string stageName,string afterStage ) {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* curr = head;
		Stage* newStage = new Stage(stageName);
		while (curr != nullptr&&curr->stageName!=afterStage) {
			curr = curr->next;
		}
		if (curr!= nullptr) {
			newStage->next = curr->next;
			curr->next = newStage;
		}
	}
	//Time Complexity: O(n) -> single loop used
	//Space Complexity: O(1) -> only unlinking and deleting a node
	void removeStage(string name) {
		if (head != nullptr) {
			Stage* prev = head;
			Stage* temp = head->next;
			if (prev->candidates.getCount() != 0) { cout << "cannot remove stage" << endl;
			return;
			}
			while (temp != nullptr) {
				if (temp->stageName == name) {
					prev->next = temp->next;
					delete temp;
					break;
				}
				prev = temp;
				temp = temp->next;
			}
		}
		else {
			throw runtime_error("head on NULL");
		}
	}
	//Time complexity: O(n) ->
	// if the arrayList was a rectangle or a square then our time complexity would have been O(n^2) but
	// since on every stage there exists different number of candidates, it does not become O(n^2) as 
	// work of the loops is bounded by the total number of candidates, hence O(s(stages) + n(number of candidates))
	//Space complexity: O(1) for best case, O(n) for worst case ->
	//best case: second last line in if allows insertion at a correct index
	//worst case: sceond last line triggers regrow() if arraylist is full and then inserts at the 
	//given index
	void moveCandidate(int CandidateID, string destinationStage) {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		int size = lengthOfPipeline();
		Candidate oldCandidate;
		Stage* curr = head;
		while (temp != nullptr && temp->stageName != destinationStage) {
			temp = temp->next;
		}
		while (curr != nullptr) {
			for (int i = 0; i < curr->candidates.getCount(); i++) {
				if (curr->candidates.At(i).getID() == CandidateID) {
					oldCandidate = curr->candidates.At(i);
					curr->candidates.removeAt(i);
					temp->candidates.insertAtEnd(oldCandidate);
					return;
				}
			}
			curr = curr->next;
		}
	}
	//Time complexity: O(n^2) -> the first while and for loop generate the O(n) as we saw for moving a
	//candidate but right after that the second while loop traverses from the very first node again, therefore
	//causing an O(n^n) -> O(n^2)
	//Space complexity: O(1) -> no new memory allocation, just traversing
	void detectDuplicates() {
		if (head != nullptr) {
			Stage* curr = head;
			bool isCorrupt= false;
			while (curr != nullptr) {
				for (int i = 0; i < curr->candidates.getCount(); i++) {
					Stage* temp = curr;
					//if candidate info is incomplete
					while (temp != nullptr) {
						for (int j=0; j < temp->candidates.getCount(); j++) {
							if (temp == curr &&j<=i) { 
								continue; 
							}//if same index or pointing to same Node
							if (curr->candidates.At(i).getID() == temp->candidates.At(j).getID()) {
								cout << "PIPELINE CORRUPTED!" << endl;
								cout << "Duplicate Candidate: ID =" << curr->candidates.At(i).getID() << endl;
								cout<< " Found in: " << curr->stageName<<", "<< temp->stageName << endl;
								isCorrupt = true;
							}
						}
						temp = temp->next;
					}
				}
				curr = curr->next;
			}
			if (!isCorrupt) {
				cout << "No duplicate Ids" << endl;
			}
		}
		else {
			throw runtime_error("head on NULL");
		}
	}
	//Time complexity: O(n) -> same logic as moveCandidate, jagged arrays allow O(s+n) instead of O(s*n)
	//Space complexity: O(1) -> no new memory allocation, just traversing
	void withdrawCandidate(int candidateID){
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		while (temp != nullptr) {
			for (int i = 0; i < temp->candidates.getCount(); i++) {
			if (temp->candidates.At(i).getID() == candidateID) {
				if (!temp->candidates.At(i).getStatus()) {
					cout << "Candidate already withdrawn" << endl;
					return;
				}
				temp->candidates.At(i).setStatus(false);
				temp->candidates.removeAt(i);
				return;
				}			
			}
			temp = temp->next;
		}
		cout << "Candidate not found!" << endl;
	}
	//Time complexity: O(n) -> same scenario as moveCandidate
	//Space complexity: O(1) -> no new memory allocation, just traversing
	void updateTechnicalScore(int candidateID, int newScore) {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		while (temp != nullptr) {
			for (int i = 0; i < temp->candidates.getCount();i++) {
				if (temp->candidates.At(i).getID() == candidateID&&temp->stageName=="Technical Interview") {
					temp->candidates.At(i).setTechScore(newScore);
				}
			}
			temp = temp->next;
		}
		cout << "Candidate not found!" << endl;
	}
	bool Search(int CandidateID) {
		if (CandidateID < 1000 || CandidateID>9999) { return false; }
		Stage* temp = head;
		while (temp != nullptr) {
			for (int i = 0; i < temp->candidates.getCount(); i++) {
				if (temp->candidates.At(i).getID() == CandidateID) {
					return true;
				}
			}
			temp = temp->next;
		}
		return false;
	}
	bool SearchStage(string stage) {
		if (stage.empty()) { return false; }
		Stage* temp = head;
		while (temp != nullptr) {
			if (temp->stageName == stage) {
				return true;
			}
			temp = temp->next;
		}
		return false;
	}
	//Time complexity: O(n) -> same scenario as moveCandidate
	//Space complexity: O(1) -> no new memory allocation, just traversing
	void updateInterviewScore(int candidateID, int newScore) {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		while (temp != nullptr) {
			for (int i = 0; i < temp->candidates.getCount(); i++) {
				if (temp->candidates.At(i).getID() == candidateID&&temp->stageName=="HR Interview") {
					temp->candidates.At(i).setInterviewScore(newScore);
				}
			}
			temp = temp->next;
		}
		cout << "Candidate not found!" << endl;
	}
	//Time complexity: O(n) -> same scenario as in moveCandidate
	//Space complexity: best case is O(1) (array has some empty spots so element can be added, no regrow()) and worst case
	//is O(n) (array is full and this triggers regrow())
	void promoteEligibleCandidates() {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		bool isPromoted = false;
		while (temp->next != nullptr) {
			Candidate old;
			for (int i = temp->candidates.getCount() - 1; i >= 0; i--) {
				if (!temp->candidates.At(i).isComplete()) {
					cout << "Incomplete candidate details" << endl;
					continue;
				}
				if(temp->candidates.At(i).getStatus() == true){
					if (temp->stageName == "Applied" && temp->candidates.At(i).getCGPA() >= 3.00) {
						isPromoted = true;
					}
					else if (temp->stageName == "Screeing" && temp->candidates.At(i).getCGPA() >= 3.2 && temp->candidates.At(i).getCounter() >= 2) {
						isPromoted = true;
					}
					else if (temp->stageName == "Technical Interview" && temp->candidates.At(i).getTechScore() >= 70) {
						isPromoted = true;
					}
					else if (temp->stageName == "HR Interview" && temp->candidates.At(i).getTechScore() >= 80 && temp->candidates.At(i).getInterviewScore() >= 75) {
						isPromoted = true;
					}
					if (isPromoted) {
						old = temp->candidates.At(i);
						temp->candidates.removeAt(i);
						temp->next->candidates.insertAtEnd(old);
					}
				}
			}
			temp = temp->next;
		}
	}
	//Time compelexity: O(n) -> checking only the max count
	//Space complexity: O(1) -> no new memory allocation
	Stage* getMostCrowdedStage() {
		if (head != nullptr) {
			Stage* curr = head;
			Stage* prev = head;
			int max = curr->candidates.getCount();
			while (curr != nullptr){
				if (curr->candidates.getCount() > max) {
					max = curr->candidates.getCount();
					prev = curr;
				}

				curr = curr->next;
			}
			return prev;
		}
		else {
			throw runtime_error("head on NULL");
		}
	}
	//Time complexity: O(n) -> one loop for reversal process
	//Space complexity: O(1) -> no new memory allocation
	Stage* reversePipeline() {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* curr = head;
		Stage* prev = nullptr;
		Stage* next = nullptr;
		while (curr != nullptr) {
			next = curr->next;
			curr->next = prev;
			prev = curr;
			curr = next;
		}
		return prev;
	}
	//Time complexity: O(n) -> single loop for display
	//Space complexity: O(1) -> no new memory allocation
	void displayStatistics()const {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		while (temp != nullptr) {
			cout << "===================================" << endl;
				cout <<"Stage: "<< temp->stageName << "->";
				cout << "candidates: ";
				if (temp->candidates.getCount() == 0) {
					cout << "no candidates in this stage" << endl;
					cout << "===================================" << endl;
					temp = temp->next;
					continue;
				}
				else {
					for (int i = 0; i < temp->candidates.getCount(); i++) {
						cout << "\nCandidate " << i + 1 << endl;
						temp->candidates.At(i).display();
					}
					cout << "===================================" << endl;
				}
			temp = temp->next;
		}
	}
	//Time complexity: O(n) -> single loop for check
	//Space complexity: O(1) -> no new memmory allocation
	bool hasCycle() {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* fast = head;
		Stage* slow = head;
		while (fast != nullptr && fast->next != nullptr) {
			slow = slow->next;
			fast = fast->next->next;
		}
		if (slow == fast) {
			return true;
		}
		return false;
	}
	//Time complexity: O(n) -> same as we saw in moveCandidate
	//Space complexity: best case is O(1) (array had empty spots so no regrow() trigger) and worst case is O(n)
	//(array is full and this triggers regrow() to allocate new spots)
	ArrayList<Candidate> findCandidatesBySkill(const string& skill){
		if (head == nullptr||skill.empty()) {
			throw runtime_error("head on NULL/empty string for skill");
		}
		ArrayList<Candidate> newArr;
		Stage* temp = head;
		while (temp != nullptr) {
			for (int i = 0; i < temp->candidates.getCount(); i++) {
					if (temp->candidates.At(i).checkSkill(skill)) {
							Candidate old;
							old = temp->candidates.At(i);
							newArr.insertAtStart(old);
							break;
					}
			
		}
			temp = temp->next;
		}
		return newArr;
	}
	void addCandidate(string stageName) {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Stage* temp = head;
		while (temp != nullptr && temp->stageName!=stageName) {
			temp = temp->next;
		}
		if (temp == nullptr) {
			cout<<"stage does not exist" << endl;
			return;
		}
		int ID = 0;
