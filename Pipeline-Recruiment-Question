			}
		} while (ID < 1000 || ID>9999);
			Candidate newCandid;
			newCandid.setID(ID);
			newCandid.configure();
			temp->candidates.insertAtEnd(newCandid);
			cout << "Candidate added" << endl;
	}
	//Time complexity: O(n) -> same jagged concept as we saw in moveCandidate
	//Space complexity: O(1) -> no new memory allocation, only output returned
	Candidate getBestCandidate() {
		if (head == nullptr) {
			throw runtime_error("head on NULL");
		}
		Candidate* bestCand = nullptr;
		Stage* curr = head;
		while (curr != nullptr) {
			for (int i = 0; i < curr->candidates.getCount(); i++) {
				Candidate* next = &curr->candidates.At(i);
				if (bestCand == nullptr) {
					bestCand = next;
				}
				if (bestCand->getFinalScore() < next->getFinalScore()) {
					bestCand = next;
				}
				else if (bestCand->getFinalScore() == next->getFinalScore()) {
					if (bestCand->getTechScore() < next->getTechScore()) {
						bestCand = next;
					}
					else if (bestCand->getTechScore() == next->getTechScore()) {
						if (bestCand->getCGPA() > next->getCGPA()) {
							bestCand = next;
						}
						else if (bestCand->getCGPA() == next->getCGPA()) {
							if (bestCand->getID() > next->getID()) {
								bestCand = next;
							}
						}
					}
				}
			}
			curr = curr->next;
		}
		if (bestCand == nullptr) {
			throw runtime_error("best on NULL");
		}
		return *bestCand;
	}
